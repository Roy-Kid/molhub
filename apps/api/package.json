{
  "name": "@molcrafts/molhub-api",
  "version": "0.1.0",
  "description": "MolHub manifest submission and review REST API",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var WEB_ORIGIN:http://localhost:4173",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply molhub-submissions --local",
    "db:migrate:remote": "wrangler d1 migrations apply molhub-submissions --remote",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test vitest.config.ts"
  },
  "dependencies": {
    "@molcrafts/molhub": "0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
