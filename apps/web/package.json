{
  "name": "@molcrafts/molhub-web",
  "description": "The MolHub product web app: discovery, artifact details, and manifest submission tooling",
  "author": {
    "name": "Roy Kid"
  },
  "license": "BSD-3-Clause",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "registry:sync": "tsx scripts/sync-registry.ts",
    "dev": "npm run registry:sync && rsbuild dev",
    "build": "npm run registry:sync && rsbuild build && npm run bundle:check",
    "bundle:check": "tsx scripts/check-inspector-bundles.ts",
    "preview": "rsbuild preview",
    "test": "npm run registry:sync && rstest run",
    "test:e2e": "playwright test",
    "test:watch": "npm run registry:sync && rstest",
    "lint": "biome check app/src e2e scripts *.config.ts",
    "format": "biome check --write app/src e2e scripts *.config.ts",
    "typecheck": "npm run registry:sync && tsc --noEmit"
  },
  "dependencies": {
    "@molcrafts/molhub": "0.1.0",
    "@molcrafts/molplot": "file:../../vendor/molcrafts-molplot-0.1.6.tgz",
    "@molcrafts/molvis-core": "file:../../vendor/molcrafts-molvis-core-0.2.0.tgz",
    "@molcrafts/molvis-stage": "file:../../vendor/molcrafts-molvis-stage-0.2.0.tgz",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-start": "^1.168.40",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@molcrafts/molhub-registry-tools": "0.1.0",
    "@playwright/test": "^1.58.0",
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/adapter-rsbuild": "^0.11.6",
    "@rstest/core": "^0.11.6",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.11.2",
    "js-yaml": "^4.1.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@11.17.0+sha512.3eeaf18997b11070d313849268b23766b9db0068997dec9471073170fe43fa17f2b4d0337bf0f52330ee2274e7f5754b21b01052742e48f5c9c74d8b1e32ef43",
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3"
  }
}
